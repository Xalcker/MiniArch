# Configuracion de disco
# ask muestra un selector interactivo con los discos detectados.
# Tambien puedes fijarlo manualmente, por ejemplo: /dev/sda, /dev/nvme0n1 o /dev/vda.
DISK_DEVICE=ask
# Tamanos de particion (numero + M o G). /home ocupa el resto del disco; se
# exige un minimo de ESP 256M, root 4G, swap 512M y 2 GiB libres para /home.
ESP_SIZE=512M
ROOT_SIZE=8G
SWAP_SIZE=2G

# Configuracion del usuario kiosko
KIOSK_USER=kiosk
# Cambia estas contrasenas antes de ejecutar el instalador.
# Si la password tiene simbolos ($, &, ;, espacios...) usa comillas simples: KIOSK_PASSWORD='pa$$w0rd'.
# El .env se lee como CLAVE=valor y no se ejecuta (ver README, "Formato del .env").
KIOSK_PASSWORD=change-me
ROOT_PASSWORD=change-root
# Si se omite, cada camino usa su propio hostname: minikiosk (YARG y foot),
# miniclonehero (Clone Hero) o minirpcs3 (RPCS3).
#KIOSK_HOSTNAME=minikiosk
# Solo para laboratorios/VMs desechables. Nunca lo actives en produccion.
ALLOW_INSECURE_DEFAULT_PASSWORD=false

# Configuracion de Plymouth
ENABLE_PLYMOUTH=true
PLYMOUTH_THEME_NAME=arch-cage
PLYMOUTH_IMAGE_PATH=./assets/plymouth-image.png

# Configuracion del cursor
CURSOR_PATH=./assets/cursor/

# Servicios remotos y drivers
# Recomendado para Cage/YARG: false. Activalo solo si necesitas mantenimiento remoto.
ENABLE_SSH=false
# nvidia-open solo soporta GPU Turing o mas nuevas (GTX 16xx / RTX 20xx en adelante).
# En GPU anteriores (GTX 10xx...) el instalador omite el driver y usa Mesa/nouveau.
INSTALL_NVIDIA=
# true omite esa deteccion de GPU (falsos positivos, passthrough...).
NVIDIA_SKIP_GPU_CHECK=false

# YARG / Cage
# stable usa YARG_URL; stable-latest consulta YARG_STABLE_API_URL;
# nightly consulta YARG_NIGHTLY_API_URL; ask pregunta al instalar.
YARG_RELEASE_CHANNEL=ask
YARG_URL=https://github.com/YARC-Official/YARG/releases/download/v0.14.0/YARG_v0.14.0-Linux-x86_64.zip
YARG_STABLE_API_URL=https://api.github.com/repos/YARC-Official/YARG/releases/latest
YARG_STABLE_ASSET_REGEX="linux.*(x86_64|x64|64).*\\.zip"
YARG_NIGHTLY_API_URL=https://api.github.com/repos/YARC-Official/YARG-BleedingEdge/releases/latest
YARG_NIGHTLY_ASSET_REGEX="linux.*(x86_64|x64|64).*\\.zip"
YARG_SONGS_DIR=/home/${KIOSK_USER}/Songs
YARG_PERSISTENT_DATA_DIR=/home/${KIOSK_USER}/.config/yarg-kiosk
# Opciones: 4k (3840x2160), 2k (2560x1440), 1080p, 720p, ask.
YARG_RESOLUTION=ask
# true fuerza llvmpipe/software render. Para GPU passthrough deja false.
YARG_FORCE_SOFTWARE_RENDER=false
# always muestra menu al salir de YARG; restart relanza YARG directo.
YARG_EXIT_MENU=always

# Clone Hero / Cage
# latest consulta GitHub; url usa CLONEHERO_URL manualmente; ask pregunta al instalar.
CLONEHERO_RELEASE_CHANNEL=latest
CLONEHERO_API_URL=https://api.github.com/repos/clonehero-game/releases/releases
CLONEHERO_ASSET_REGEX="linux.*(x86_64|x64|64|amd64).*(zip|tar\\.xz|tar\\.gz|appimage)$"
CLONEHERO_URL=
CLONEHERO_SONGS_DIR=/home/${KIOSK_USER}/Songs
CLONEHERO_DATA_DIR=/home/${KIOSK_USER}/.clonehero
# Opciones: 4k (3840x2160), 2k (2560x1440), 1080p, 720p, ask.
CLONEHERO_RESOLUTION=ask
# true fuerza llvmpipe/software render. Para GPU passthrough deja false.
CLONEHERO_FORCE_SOFTWARE_RENDER=false
# always muestra menu al salir de Clone Hero; restart relanza Clone Hero directo.
CLONEHERO_EXIT_MENU=always

# RPCS3 / Cage (Rock Band 3)
# RPCS3_URL vacio consulta el ultimo release de RPCS3/rpcs3-binaries-linux.
RPCS3_URL=
RPCS3_API_URL=https://api.github.com/repos/RPCS3/rpcs3-binaries-linux/releases/latest
RPCS3_ASSET_REGEX="linux64.*\.AppImage$"
# true descarga el firmware oficial de PS3 al home del usuario.
RPCS3_DOWNLOAD_FIRMWARE=true
RPCS3_FIRMWARE_URL=http://dus01.ps3.update.playstation.net/update/ps3/image/us/2026_0318_a2b60b6ac1d2e49e230144345616927c/PS3UPDAT.PUP
# true descarga la ultima build de Rock Band 3 Deluxe (PS3, ~750 MB) a
# /home/<usuario>/RB3DX-PS3.zip.
RB3DX_DOWNLOAD=true
RB3DX_URL=https://nightly.link/hmxmilohax/rock-band-3-deluxe/workflows/build/develop/RB3DX-PS3.zip
# true descarga los tres perfiles de configuracion de RB3DX (recommended, minimum
# y potato) como zips en /home/<usuario>; se instala uno al configurar el juego.
RB3DX_DOWNLOAD_CONFIGS=true
# Perfil de configuracion que se aplica: recommended, minimum, potato o none.
# Vacio = el instalador pregunta. Los tres zips se descargan siempre.
RB3DX_CONFIG_PROFILE=
RB3DX_CONFIG_BASE_URL=https://guides.milohax.org/downloads/rb3/rpcs3/customconfigs
RPCS3_GAMES_DIR=/home/${KIOSK_USER}/Games
# Ruta fija al EBOOT.BIN; vacio = buscar un PARAM.SFO cuyo titulo contenga RPCS3_GAME_MATCH.
RPCS3_GAME_PATH=
RPCS3_GAME_MATCH="Rock Band 3"
# Vacio = automatico; wayland o xcb (XWayland).
RPCS3_QT_PLATFORM=
# always muestra menu al salir del juego; restart relanza directo; never sale.
RPCS3_EXIT_MENU=always
# Bateria electronica MIDI por USB: true detecta el puerto antes de cada arranque
# y lo asigna como "Drums" en la configuracion del juego.
RPCS3_MIDI_DRUMS=true
# Notas MIDI que el kit manda distintas a lo esperado, "NOTA=Pieza,NOTA=Pieza"
# (p. ej. 49=Ride,51=Crash si crash y ride llegan invertidos, como en el Alesis
# Nitro). Piezas: Kick, HihatPedal, Snare, SnareRim, HiTom, LowTom, FloorTom,
# HihatWithPedalUp, Hihat, Ride, Crash. Vacio no toca rb3drums.yml.
RPCS3_MIDI_NOTE_OVERRIDE=
# Control del jugador 1: true instala la configuracion de entrada con el handler
# SDL (sin ella RPCS3 asigna el teclado y un control no navega por los menus).
# RPCS3_PAD_DEVICE es el nombre que SDL da al control, con su numero (en la GUI
# de RPCS3: Pads > Device). No se pisa una configuracion existente.
RPCS3_PAD_CONFIG=true
RPCS3_PAD_DEVICE=Xbox Series X Controller 1
# true instala el atajo para cerrar RPCS3 con Ctrl+Alt+Q (teclado). Con un control se sale
# desde el menu de RPCS3 (boton Guide).
RPCS3_EXIT_HOTKEY=true
# Salida de audio preferida: hdmi (HDMI/DP), analog o auto. Si el dispositivo
# preferido no existe se usa el otro.
RPCS3_AUDIO_OUTPUT=hdmi
# Volumen de la salida al arrancar el kiosko, de 0 a 1 (1.0 = 100 %). Vacio no lo toca.
RPCS3_AUDIO_VOLUME=1.0
# Buffer de audio de RPCS3 en ms para los perfiles RB3DX descargados (32 es el de
# recommended; minimum y potato traen 100). Vacio deja el valor de cada perfil.
RPCS3_AUDIO_BUFFER_MS=32
# Microfonos USB para hasta 3 cantantes. El wrapper los asigna a Mic_P1, Mic_P2 y
# Mic_P3 en este orden: primero los individuales (SINGLE_MATCH, el Logitech
# oficial de Rock Band), luego cada adaptador estereo de dos microfonos
# (SPLIT_MATCH, el SingStar USBMIC: izquierdo = azul, derecho = rojo). Son
# expresiones regulares sobre el nombre de la fuente ALSA; ambas vacias
# desactivan la funcion.
RPCS3_MIC_SINGLE_MATCH=Logitech
RPCS3_MIC_SPLIT_MATCH=USBMIC|SingStar
# Volumen de captura de cada tipo (salen al maximo y se cruzan entre jugadores):
# 75% = +7 dB en el Logitech; 35% = -4 dB en el SingStar USBMIC. Vacio no lo toca.
RPCS3_MIC_SINGLE_VOLUME=75%
RPCS3_MIC_VOLUME=35%
# Disco minimo en GB para este camino.
RPCS3_MIN_DISK_GB=32

# Configuracion regional y logs
TIMEZONE=America/Phoenix
LOG_FILE=/var/log/arch-cage-install.log
# false oculta salida ruidosa de pacman/pacstrap/unzip/etc. y la manda al log.
VERBOSE_INSTALL=false
